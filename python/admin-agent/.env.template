# ============================================================================
# Admin Agent Configuration Template
# Copy this file to .env and fill in your actual values
# ============================================================================

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=<<YOUR_AZURE_OPENAI_API_KEY>>
AZURE_OPENAI_ENDPOINT=<<YOUR_AZURE_OPENAI_ENDPOINT>>
AZURE_OPENAI_DEPLOYMENT=<<YOUR_DEPLOYMENT_NAME>>
AZURE_OPENAI_API_VERSION=2024-10-21

# Agent 365 MCP Platform Configuration
MCP_SERVER_HOST=https://agent365.svc.cloud.microsoft
MCP_PLATFORM_ENDPOINT=<<YOUR_MCP_PLATFORM_ENDPOINT>>

# Agent 365 Agentic Authentication Configuration
# Service connection for agent identity
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=<<YOUR_CLIENT_ID>>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=<<YOUR_CLIENT_SECRET>>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=<<YOUR_TENANT_ID>>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__SCOPES=https://graph.microsoft.com/.default

# User authorization settings
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__TYPE=AgenticUserAuthorization
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__SCOPES=https://graph.microsoft.com/.default
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__ALTERNATEBLUEPRINTCONNECTIONNAME=https://graph.microsoft.com/.default

# Connection mapping
CONNECTIONSMAP_0_SERVICEURL=*
CONNECTIONSMAP_0_CONNECTION=SERVICE_CONNECTION

# Admin Agent Specific Settings
# The mailbox identity of the admin agent (e.g., adminagent@contoso.com)
ADMIN_AGENT_EMAIL=<<YOUR_ADMIN_AGENT_EMAIL>>

# Delegated user (the user whose calendar this agent manages)
DELEGATED_USER_EMAIL=<<DELEGATED_USER_EMAIL>>

# Auto-accept rules configuration
AUTO_ACCEPT_FROM_DOMAINS=<<COMMA_SEPARATED_DOMAINS>>  # e.g., contoso.com,microsoft.com
AUTO_ACCEPT_MAX_DURATION_HOURS=2  # Maximum meeting duration to auto-accept
AUTO_DECLINE_OUTSIDE_HOURS=true  # Decline meetings outside working hours

# Working hours (for auto-decline logic)
WORKING_HOURS_START=09:00
WORKING_HOURS_END=17:00

# Server Configuration
PORT=3978
USE_AGENTIC_AUTH=true

# Logging Configuration
LOG_LEVEL=INFO

# Observability Configuration
ENABLE_OBSERVABILITY=true
ENABLE_A365_OBSERVABILITY_EXPORTER=false
ENABLE_OTEL=true
ENABLE_SENSITIVE_DATA=true

OBSERVABILITY_SERVICE_NAME=admin-agent
OBSERVABILITY_SERVICE_NAMESPACE=agent365.samples

# Environment
PYTHON_ENVIRONMENT=development

# Bearer token (for testing - leave empty for production)
BEARER_TOKEN=
